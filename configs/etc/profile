# Begin /etc/profile

for i in $(locale); do
  unset ${i%=*}
done

if [[ "$TERM" = linux ]]; then
  export LANG=C.UTF-8
else
  source /etc/locale.conf

  for i in $(locale); do
    key=${i%=*}
    if [[ -v $key ]]; then
      export $key
    fi
  done
fi

# Source /etc/profile.d/*.sh
for i in /etc/profile.d/*.sh; do
  [ -r "$i" ] && . "$i"
done
unset i

# End /etc/profile
